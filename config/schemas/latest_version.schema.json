{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ridemate:config:latest_version",
  "title": "latest_version (contracts §2.7)",
  "description": "Newest released app version for the in-app update prompt.",
  "type": "object",
  "required": [
    "schema",
    "version_code",
    "version_name",
    "url",
    "sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "version_code": {
      "type": "integer",
      "minimum": 1
    },
    "version_name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/"
    },
    "sha256": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    }
  }
}
