{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ridemate:config:model_route",
  "title": "model_route (contracts §2.7)",
  "description": "Provider route per AI task; lets a funded provider be added without code changes.",
