{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ridemate:config:budget_horizon_start",
  "title": "budget_horizon_start (contracts §2.7)",
  "description": "Pacing horizon start date. Stored as {\"value\": ...}; published as a Remote Config scalar.",
  "type": "object",
  "required": [
    "value"
  ],
  "additionalProperties": false,
  "properties": {
    "value": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    }
  }
}
