{
  "schema": "1.0",
  "notes": {
    "com.ubercab": "Best-effort initial patterns from general knowledge (English + Hindi), unverified until recorded with the owner's Recorder. Kept conservative so misses fall to the MAYBE prompts.",
    "com.olacabs.customer": "Best-effort initial patterns from general knowledge (English + Hindi), unverified until recorded with the owner's Recorder. Kept conservative so misses fall to the MAYBE prompts.",
