    "com.ubercab": [
      {
        "min_version_code": 0,
        "vehicle_labels": [
          {
            "pattern": "(?i)\\b(?:parcel|package|courier|delivery|rentals?|intercity)\\b",
            "vehicle_class": "other"
          },
          {
            "pattern": "(?i)\\b(?:uber ?)?xl\\b|\\bxl ?plus\\b|\\bsuv\\b",
            "vehicle_class": "cab_xl"
          },
          {
            "pattern": "(?i)\\bpremier\\b|\\buber ?black\\b|\\bcomfort\\b",
            "vehicle_class": "cab_premium"
          },
          {
            "pattern": "(?i)\\b(?:uber ?)?moto\\b|\\bbike\\b|बाइक",
            "vehicle_class": "bike"
          },
          {
            "pattern": "(?i)\\b(?:uber ?)?auto\\b|ऑटो",
            "vehicle_class": "auto"
          },
          {
            "pattern": "(?i)\\buber ?go\\b|\\bgo ?sedan\\b|^go$|\\bgo ?(?:non[ -]?ac|ac)\\b|कैब",
            "vehicle_class": "cab_economy"
          }
        ],
        "price_token_pattern": "(?i)(?:₹|\\brs\\.?|\\binr)[\\s\\x{00A0}\\x{202F}]*[0-9०-९][0-9०-९,]*(?:\\.[0-9]{1,2})?(?:[\\s\\x{00A0}\\x{202F}]*[-–—][\\s\\x{00A0}\\x{202F}]*(?:₹|\\brs\\.?|\\binr)?[\\s\\x{00A0}\\x{202F}]*[0-9०-९][0-9०-९,]*(?:\\.[0-9]{1,2})?)?",
        "eta_pattern": "(?i)([0-9०-९]{1,2})[\\s\\x{00A0}]*(?:mins?\\b|minutes?\\b|मिनट)",
        "strike_height_ratio": 0.8,
        "row_gap_ratio": 1.8,
        "driver_eta_anchors": [
          "away",
          "arriving",
          "pickup",
          "reach",
          "मिनट",
          "दूर"
        ],
        "driver_distance_pattern": "(?i)(\\d+(?:\\.\\d+)?)[\\s\\x{00A0}]*(km|m)\\b",
        "screen_keywords": {
          "fare_options": [
            "choose a ride",
            "choose a trip"
          ],
          "searching": [
            "looking for",
            "finding",
            "connecting you"
          ],
          "driver_assigned": [
            "on the way",
            "arriving",
            "pin",
            "otp",
            "away"
