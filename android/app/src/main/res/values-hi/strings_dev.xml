<resources>
    <string name="dev_title">डेवलपर मोड</string>
    <string name="dev_intro">मालिक के टूल। यहाँ की हर चीज़ इस फ़ोन पर ही रहती है, जब तक आप स्वयं साझा न करें। RideMate राइड ऐप्स के अंदर कभी कोई कार्य नहीं करता।</string>
    <string name="dev_off_title">डेवलपर मोड बंद है</string>
    <string name="dev_off_body">डेवलपर मोड केवल RideMate के मालिक के लिए है। मालिक के Google खाते से साइन इन करें और \"RideMate के बारे में\" में संस्करण पर सात बार टैप करें।</string>
    <string name="dev_ok">ठीक है</string>
    <string name="dev_yes">हाँ</string>
    <string name="dev_no">नहीं</string>
    <string name="dev_close">बंद करें</string>
