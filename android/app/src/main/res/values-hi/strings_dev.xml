    <string name="dev_share_title">एक्सपोर्ट साझा करें</string>

    <string name="dev_recorder">रिकॉर्डर</string>
    <string name="dev_recorder_body">Uber, Ola और Rapido की हर सूचना और उसके हटने को मास्क किए टेक्स्ट के साथ दर्ज करता है: पैकेज, चैनल, श्रेणी, जारी (ongoing) स्थिति, id और tag, रिडैक्शन और हटने का कारण।</string>
    <string name="dev_recorder_switch">राइड ऐप्स की सूचनाएँ रिकॉर्ड करें</string>
    <plurals name="dev_recorder_recent">
        <item quantity="one">%d हाल की प्रविष्टि</item>
        <item quantity="other">%d हाल की प्रविष्टियाँ</item>
    </plurals>
