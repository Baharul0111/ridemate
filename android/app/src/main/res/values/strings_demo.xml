<?xml version="1.0" encoding="utf-8"?>
<!-- Try the demo (goal 19). Owned by app.ridemate.demo. Every demo provider is fictional and labelled DEMO. -->
<resources>
    <string name="demo_title">Try the demo</string>
    <string name="demo_badge">DEMO</string>
    <string name="demo_badge_description">Demo mode: fictional ride companies, no real bookings and no money</string>
    <string name="demo_intro">Sample screens from three made-up ride companies show how RideMate reads prices, spots your driver, guides you to cancel the other bookings with proof, and hands you back to pay. You need no ride app, no sign-in and no AI budget.</string>
    <string name="demo_provider_label">%1$s · DEMO</string>

    <!-- Choosing a walk-through. -->
    <string name="demo_track_main_title">Book three, keep one</string>
    <string name="demo_track_main_body">Book in all three demo apps. When the first driver is found, RideMate asks to cancel the others, guides each cancel, proves it and reminds you until every one is gone.</string>
    <string name="demo_track_keep_searching_title">Keep searching</string>
    <string name="demo_track_keep_searching_body">Keep looking after the first driver. A much closer driver brings a better-ride offer, and nothing changes unless you tap Yes. In real rides, dropping a driver may cost a fee and costs that driver a trip, so use this fairly.</string>
    <string name="demo_track_rematch_title">Driver cancels</string>
    <string name="demo_track_rematch_body">One booking: the driver cancels, the app finds a closer driver, and RideMate follows every change.</string>
    <string name="demo_start">Start</string>
    <string name="demo_start_description">Start the demo: %1$s</string>
    <string name="demo_leave">Leave demo</string>
    <string name="demo_leave_description">Leave the demo. Your real rides are not affected.</string>

    <!-- Why the demo can't start; each says what to do next. -->
    <string name="demo_unavailable_not_ready">The demo isn\'t available in this version of RideMate. Update the app, then try again.</string>
    <string name="demo_unavailable_switched_off">The demo is switched off for now. Try again later.</string>
    <string name="demo_unavailable_session_busy">RideMate is still looking after your ride bookings. Finish or cancel them first, then start the demo.</string>
    <string name="demo_unavailable_assets_broken">The demo files are damaged. Reinstall RideMate to restore them.</string>

    <!-- Where the user is. -->
    <string name="demo_step_book">Step %1$d of %2$d: read the prices in %3$s, then tap Booked here.</string>
    <string name="demo_step_watching">All booked. RideMate now watches each demo app\'s notifications, just as it does for Uber, Ola and Rapido. Wait for a driver.</string>
    <string name="demo_step_finished">Demo complete. In a real ride you pay inside the ride app. RideMate never handles money.</string>
    <string name="demo_app_cancel_hint">RideMate opened %1$s so you can cancel this extra booking. Tap Cancel ride, as you would in the real app.</string>
    <string name="demo_app_pay_hint">This is where you would pay in %1$s. Demo: no money moves.</string>
    <string name="demo_cancel_waiting">Cancel tapped. Waiting for %1$s to confirm it…</string>
    <string name="demo_cancel_proven">Cancelled. %1$s\'s own notification proved it.</string>

    <!-- Controls. -->
    <string name="demo_action_read_fares">Read fares</string>
    <string name="demo_action_read_fares_description">Read the prices on the %1$s demo screen with two independent readers</string>
    <string name="demo_action_reading">Reading prices…</string>
    <string name="demo_action_booked_here">Booked here</string>
    <string name="demo_action_booked_here_description">I booked a ride in %1$s (demo)</string>
    <string name="demo_action_cancel_ride">Cancel ride</string>
    <string name="demo_action_cancel_ride_description">Tap Cancel ride in %1$s (demo), as you would in the real app</string>
    <string name="demo_action_show_me">Show me</string>
    <string name="demo_action_show_me_description">Show me where Cancel ride is in %1$s</string>
    <string name="demo_action_pay">Pay in %1$s</string>
    <string name="demo_action_pay_description">Open %1$s to pay (demo: no money moves)</string>
