    <!-- Why a read has no AI read or no rows; each says what to do next. -->
    <string name="demo_issue_ai_switched_off">AI reading is switched off and RideMate\'s server couldn\'t be reached, so the demo used the recorded read bundled in the app.</string>
    <string name="demo_issue_ai_unavailable">AI reading isn\'t available and no recorded read is bundled, so prices show as Couldn\'t read. Try again when you\'re online.</string>
    <string name="demo_issue_not_a_fare_screen">This doesn\'t look like a fare screen, so nothing was sent. Open the fare screen and try again.</string>
    <string name="demo_issue_ocr_failed">Your phone couldn\'t read the screen text. Tap Read fares again.</string>
    <string name="demo_issue_no_parser">Reading rules for this demo app are missing. Update RideMate, then try again.</string>
    <string name="demo_issue_recorded_fallback">RideMate\'s server couldn\'t be reached, so the demo used the recorded read bundled in the app.</string>

