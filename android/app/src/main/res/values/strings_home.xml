    <!-- Pre-session issues: what is wrong, why, and the fix. -->
    <string name="home_issue_listener_title">RideMate can\'t see ride-app notifications</string>
    <string name="home_issue_listener_body">Without notification access RideMate can\'t tell when a driver accepts, so it can\'t remind you to cancel extra bookings.</string>
    <string name="home_issue_listener_action">Turn on notification access</string>
    <string name="home_issue_overlay_title">The floating button is off</string>
    <string name="home_issue_overlay_body">RideMate needs \"Display over other apps\" to show its button over the ride apps.</string>
    <string name="home_issue_overlay_action">Turn on the floating button</string>
    <string name="home_issue_notif_title">Notifications are off</string>
    <string name="home_issue_notif_body">Reminders to cancel extra bookings appear as notifications.</string>
    <string name="home_issue_notif_action">Turn on notifications</string>
    <string name="home_issue_no_app_title">No ride app installed</string>
    <string name="home_issue_no_app_body">Install Uber, Ola or Rapido to compare real prices, or try the demo now.</string>
    <string name="home_issue_battery_title">Battery saving may delay reminders</string>
    <string name="home_issue_battery_body">Allow RideMate to run in the background so reminders arrive on time.</string>
    <string name="home_issue_battery_action">Allow background running</string>
    <string name="home_issue_location_title">Location is off</string>
    <string name="home_issue_location_body">You\'ll type your pickup address yourself. Turn on location in App info → Permissions to fill it in automatically.</string>
    <string name="home_issue_location_action">Open App info</string>
